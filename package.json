{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' next dev",
    "dev:api": "tsx watch app/api/src/index.ts",
    "dev:worker": "tsx watch app/api/src/worker.ts",
    "start:worker": "tsx app/api/src/worker.ts",
    "build": "node check-env.js && next build",
    "build:api": "esbuild app/api/src/index.ts --bundle --platform=node --target=node20 --external:@prisma/client --external:prisma --external:ioredis --external:bullmq --outfile=dist/index.js",
    "build:worker": "esbuild app/api/src/worker.ts --bundle --platform=node --target=node20 --external:@prisma/client --external:prisma --external:ioredis --external:bullmq --outfile=dist/worker.js",
    "build:all": "pnpm build && pnpm build:api && pnpm build:worker",
    "start": "next start",
    "start:api": "node dist/index.js",
    "start:prod-worker": "node dist/worker.js",
    "lint": "eslint && pnpm lint:agent-boundary",
    "lint:agent-boundary": "tsx scripts/lint-agent-boundary.ts",
    "lint:agent-boundary:update": "tsx scripts/lint-agent-boundary.ts --update",
    "test": "node --import tsx --test 'app/api/src/**/*.test.ts'",
    "test:unit": "node --import tsx --test --test-name-pattern='unit' 'app/api/src/**/*.test.ts'",
    "test:integration": "node --import tsx --test --test-name-pattern='integration' 'app/api/src/**/*.test.ts'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@google/generative-ai": "^0.24.1",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/helmet": "^4.0.0",
    "apify-client": "^2.24.0",
    "axios": "^1.17.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.77.3",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "framer-motion": "^13.1.1",
    "googleapis": "^173.0.0",
    "helmet": "^8.3.0",
    "html-to-text": "^10.0.0",
    "https-proxy-agent": "^9.1.0",
    "imapflow": "^1.3.5",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.21.0",
    "luxon": "^3.7.2",
    "next": "16.2.6",
    "nodemailer": "^8.0.10",
    "p-limit": "^7.3.1",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^5.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "resend": "^6.12.4",
    "svix": "^1.95.1",
    "swr": "^2.4.1",
    "tldts": "^7.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.2",
    "@types/node": "^20.19.41",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  }
}
