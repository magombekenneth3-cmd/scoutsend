═════════════════════════════════════

# ─── REQUIRED (server won't start without these) ────────────────
DATABASE_URL=postgresql://user:pass@host:5432/dbname?connection_limit=10&pool_timeout=10
#             ↑ connection_limit=10 prevents pool exhaustion on small Postgres instances

JWT_SECRET=<64-char random hex>          # openssl rand -hex 32
REDIS_URL=redis://:password@host:6379
ALLOWED_ORIGIN=https://app.yourdomain.com
APP_URL=https://app.yourdomain.com
INTERNAL_API_URL=http://localhost:8080   # internal URL used by Next.js proxy
GEMINI_API_KEY=<your Gemini API key>

MAILBOX_ENCRYPTION_KEY=<32-byte hex>     # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

SYSTEM_SMTP_HOST=smtp.yourprovider.com
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_SECURE=false
SYSTEM_SMTP_USER=noreply@yourdomain.com
SYSTEM_SMTP_PASS=<smtp password>
SYSTEM_SMTP_FROM=ScoutSend <noreply@yourdomain.com>

WEBHOOK_SECRET=<32-char random hex>    
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=<from Resend dashboard>

PORT=8080
LOG_LEVEL=info
NODE_ENV=production

# ─── AUTH COOKIE (critical for cross-subdomain) ─────────────────
COOKIE_SAME_SITE=none                    # required when API and frontend are on different subdomains
COOKIE_DOMAIN=.yourdomain.com            # e.g. .scoutsend.io — note the leading dot

# ─── FEATURE FLAGS (warn at startup if missing, not a crash) ─────
APOLLO_API_KEYS=key1,key2
SERPER_API_KEYS=key1,key2
GOOGLE_PLACES_API_KEYS=key1

# ─── BILLING (Stripe) ────────────────────────────────────────────
STRIPE_WEBHOOK_SECRET=whsec_...          # From Stripe Dashboard → Webhooks → Signing Secret

# ─── ERROR MONITORING ────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...    # Create free project at sentry.io

# ─── EMAIL ENRICHMENT & VERIFICATION ────────────────────────────
HUNTER_API_KEY=<hunter.io key>
ZEROBOUNCE_API_KEY=<zerobounce key>

# ─── LINKEDIN / UNIPILE ─────────────────────────────────────────
UNIPILE_API_KEY=<key>
UNIPILE_BASE_URL=https://api5.unipile.com:13523
UNIPILE_WEBHOOK_SECRET=<secret>
LINKEDIN_PROVIDER=unipile

# ─── LEAD ENRICHMENT PROVIDERS ──────────────────────────────────
BUILTIWITH_API_KEY=<key>

# ─── CRM HANDOFF ────────────────────────────────────────────────
CRM_PROVIDER=hubspot                     # or salesforce, or leave unset to disable
HUBSPOT_ACCESS_TOKEN=pat-...
HUBSPOT_PORTAL_ID=<portal id>

# ─── CALENDAR ────────────────────────────────────────────────────
CALENDLY_URL=https://calendly.com/yourname

# ─── SLACK NOTIFICATIONS ─────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ─── ANTHROPIC (fallback model) ──────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── GDPR DATA RETENTION ─────────────────────────────────────────
GDPR_DATA_RETENTION_DAYS=730            # 2 years. Set to 0 to disable purge.

# ─── NEXT.JS PUBLIC ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
