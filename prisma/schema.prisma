generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum UserRole {
  ADMIN
  OPERATOR
  REVIEWER
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum PlanTier {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
}

enum ConsentBasis {
  EXPLICIT_CONSENT
  LEGITIMATE_INTEREST
  EXISTING_BUSINESS_RELATIONSHIP
}

enum CrmProvider {
  HUBSPOT
  SALESFORCE
}

enum EmailStatus {
  NOT_ATTEMPTED
  PENDING
  FOUND
  NOT_FOUND
  INVALID
  BOUNCED
  SUPPRESSED
  PENDING_VERIFICATION
}

enum SignalType {
  HIRING_SIGNAL
  FUNDING_SIGNAL
  GROWTH_SIGNAL
  TECH_SIGNAL
  INTENT_SIGNAL
  RISK_SIGNAL
  WEBSITE_COPY
  UNKNOWN
}

enum CampaignStatus {
  DRAFT
  RESEARCHING
  GENERATING
  REVIEW
  QUEUED
  SENDING
  PAUSED
  COMPLETED
  FAILED
  CANCELED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DeliveryState {
  DRAFT
  VALIDATED
  AUTHORIZED
  DISPATCHING
  QUEUED
  SENT
  DELIVERED
  OPENED
  REPLIED
  BOUNCED
  FAILED
  SUPPRESSED
  SENDING
  SPAM
  BLOCKED
  CANCELLED
}

enum ReplyIntent {
  POSITIVE
  NEGATIVE
  NOT_INTERESTED
  OUT_OF_OFFICE
  MEETING_REQUEST
  QUESTION
  UNKNOWN
}

enum PipelineStage {
  PROSPECT
  ENGAGED
  HOT
  MEETING_BOOKED
  DISQUALIFIED
}

enum QueueJobStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
  DELAYED
  PAUSED
}

enum DomainHealth {
  HEALTHY
  WARNING
  DEGRADED
  BLOCKED
}

enum WarmupState {
  NOT_STARTED
  OBSERVATION
  RAMPING
  STABLE
  COOLDOWN
  PAUSED
  RECOVERY
}

enum MailProviderType {
  GMAIL
  OUTLOOK
  SMTP
}

enum DeliverabilityEventType {
  BOUNCE
  SOFT_BOUNCE
  HARD_BOUNCE
  SPAM_COMPLAINT
  UNSUBSCRIBE
  DELIVERY_FAILURE
  DOMAIN_BLOCKED
  MAILBOX_BLOCKED
  MAILBOX_ROTATED
  SUBJECT_LINE_EXHAUSTION
  CONFIG_ERROR
  HEALTH_WARNING
  HEALTH_DEGRADED
  HEALTH_BLOCKED
  SEED_WARMUP_SPAM_LANDING
  SEED_WARMUP_ENGAGED
}

enum DeliverabilityEventSeverity {
  INFO
  WARNING
  CRITICAL
}

enum LearningEventType {
  REVIEW_FLAGGED
  HUMAN_EDITED
  HUMAN_APPROVED
  HUMAN_REJECTED
  AUTO_APPROVED
}

enum LearningOutcome {
  PENDING_REVIEW
  APPROVED
  REJECTED
  EDITED_AND_APPROVED
  DISMISSED
}

enum Channel {
  EMAIL
  LINKEDIN_VISIT
  LINKEDIN_CONNECT
  LINKEDIN_MESSAGE
  LINKEDIN_INMAIL
  LINKEDIN_POST_CONNECT
}

enum StepTrigger {
  AFTER_DELAY
  ON_NO_REPLY
  ON_OPEN
  ON_CONNECT_ACCEPT
  ON_NO_ACCEPT
}

enum StepExecutionStatus {
  PENDING
  SCHEDULED
  EXECUTING
  DONE
  FAILED
  SKIPPED
}

enum LinkedInStatus {
  PENDING
  SENT
  ACCEPTED
  REPLIED
  FAILED
  WITHDRAWN
}

enum LeadJourneyEventType {
  EMAIL_SENT
  EMAIL_DELIVERED
  EMAIL_OPENED
  EMAIL_CLICKED
  EMAIL_BOUNCED
  LINKEDIN_VISITED
  LINKEDIN_CONNECT_SENT
  LINKEDIN_CONNECT_ACCEPTED
  LINKEDIN_MESSAGED
  REPLY_RECEIVED
  SEQUENCE_STEP_EXECUTED
  PIPELINE_STAGE_CHANGED
  MEETING_BOOKED
  SIGNAL_DETECTED
  SCORE_UPDATED
  SUPPRESSED
}

enum DiscoverySourceType {
  APOLLO_SEARCH
  SERPER_SEARCH
  BUILTWITH_TECH
  JOB_INTEL
  COMMUNITY_INTENT
  ENRICHMENT_REFRESH
  LOOKALIKE
  CSV_IMPORT
  LINKEDIN_SEARCH
}

enum DiscoveryRunStatus {
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

enum LeadState {
  DISCOVERED
  RESEARCH_PENDING
  ENRICHING
  ENRICHED
  SIGNALS_EVALUATED
  SCORE_PENDING
  SCORED
  EMAIL_REVEAL_PENDING
  EMAIL_REVEALED
  EMAIL_VALIDATING
  EMAIL_VERIFIED
  CONTENT_PENDING
  CONTENT_READY
  COMPLIANCE_PENDING
  SEND_ELIGIBLE
  QUEUED
  SENT
  WAITING_FOR_REPLY
  REPLIED
  DISQUALIFIED
  SUPPRESSED
  UNSUBSCRIBED
  BOUNCED
  COMPLAINT
  SEQUENCE_STOPPED
  MEETING_BOOKED
  CONVERTED
  FAILED_RETRYABLE
  FAILED_TERMINAL
}

enum EmailValidationStatus {
  UNKNOWN
  REVEALED
  VALID
  INVALID
  RISKY
  CATCH_ALL
}

enum OperationStatus {
  PENDING
  RUNNING
  RECOVERABLE
  LEASE_EXPIRED
  SUCCEEDED
  FAILED
}


enum CatchAllPolicy {
  SKIP
  SEND
  HOLD
}

enum TemplateStyle {
  BRANDED
  PLAIN
}

enum ResearchStatus {
  PENDING
  RUNNING
  COMPLETE
  PARTIAL
  FAILED
  STALE
  CANCELLED
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
  STALE
}

enum AgentOutputType {
  TEXT
  BOOLEAN
  NUMBER
}

enum ProposalExecutionStatus {
  STARTED
  SUCCEEDED
  FAILED
  REJECTED
}

model AgentProposalExecution {
  id                 String                  @id @default(cuid())

  proposalId         String                  @unique
  proposalHash       String
  requestFingerprint String
  contextHash        String
  agentName          String
  outreachMessageId  String?                 @unique

  status             ProposalExecutionStatus

  createdAt          DateTime                @default(now())
  startedAt          DateTime?
  completedAt        DateTime?

  errorCode          String?
  errorMessage       String?

  @@index([proposalId])
  @@index([requestFingerprint])
  @@index([contextHash])
  @@index([outreachMessageId])
}

model GeneratedProposalCache {
  id                 String    @id @default(cuid())

  proposalId         String    @unique
  agentName          String
  leadId             String
  campaignId         String

  // Complete generated payload — immutable once written
  subject            String
  body               String
  subjectVariant     String?
  leadingSignal      String?
  ctaTier            String?
  confidence         Float
  reasoning          String?

  // Proposal metadata & telemetry
  proposalHash       String
  contextHash        String
  requestFingerprint String
  expiresAt          DateTime
  tokenInput         Int       @default(0)
  tokenOutput        Int       @default(0)
  tokenTotal         Int       @default(0)
  latencyMs          Int       @default(0)

  // Lifecycle state machine & lease fencing
  // Status: GENERATED | PERSISTING | PERSISTED | PERSIST_FAILED | EXPIRED | PERSISTENCE_EXHAUSTED
  persistenceStatus  String    @default("GENERATED")
  persistAttempts    Int       @default(0)
  lastPersistError   String?
  persistedMessageId String?
  leaseToken         String?
  leaseExpiresAt     DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([leadId, campaignId, contextHash])
  @@index([persistenceStatus, updatedAt])
}

model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique

  members     OrganizationMember[]
  invitations OrganizationInvitation[]

  campaigns      Campaign[]
  senderMailboxes SenderMailbox[]
  senderDomains   SenderDomain[]
  suppressions    Suppression[]
  brandSettings   BrandSettings?
  linkedInAccounts LinkedInAccount[]
  competitorInsights CompetitorInsight[]
  agentColumns    LeadAgentColumn[]

  notifications   Notification[]
  subscription    Subscription?
  crmIntegrations CrmIntegration[]
  consentRecords  ConsentRecord[]
  apiKeys         ApiKey[]
  learningEvents  LearningEvent[]


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model ApiKey {
  id          String    @id @default(cuid())
  orgId       String
  name        String
  keyHash     String    @unique
  keyPrefix   String
  scopes      String[]
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([keyHash])
}


model OrganizationMember {
  id    String  @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role            OrgRole @default(MEMBER)
  invitedByUserId String?
  invitedAt       DateTime?
  joinedAt        DateTime?

  createdAt DateTime @default(now())

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

model OrganizationInvitation {
  id    String  @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  email           String
  role            OrgRole  @default(MEMBER)
  token           String   @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  invitedByUserId String
  invitedBy       User     @relation("SentInvitations", fields: [invitedByUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([email])
  @@index([token])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole @default(OPERATOR)
  tokenVersion Int      @default(0)
  emailVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns          Campaign[]
  brandSettings      BrandSettings?
  auditLogs          AuditLog[]
  approvals          OutreachMessage[]
  senderDomains      SenderDomain[]
  senderMailboxes    SenderMailbox[]
  draftReplies       Reply[]              @relation("ReplyDraftSentBy")
  suppressions       Suppression[]
  linkedInAccounts   LinkedInAccount[]
  triggeredResearch  LeadResearchReport[]
  agentColumns       LeadAgentColumn[]
  triggeredAgentRuns LeadAgentRun[]
  competitorInsights CompetitorInsight[]
  seedMailboxes      SeedMailbox[]

  orgMemberships OrganizationMember[]
  sentInvitations OrganizationInvitation[] @relation("SentInvitations")
  learningEvents  LearningEvent[]
  sessions        UserSession[]
}

model UserSession {
  id        String   @id @default(cuid())
  jti       String   @unique
  familyId  String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CompetitorInsight {
  id          String   @id @default(cuid())
  userId      String
  tool        String
  painPoint   String
  sentiment   String
  source      String?
  userFixesIt Boolean?
  userNote    String?
  severity    String   @default("medium")
  fetchedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@unique([userId, tool, painPoint])
  @@index([userId, tool])
  @@index([orgId])
}

model Campaign {
  id             String          @id @default(cuid())
  name           String
  description    String?
  status         CampaignStatus  @default(DRAFT)
  previousStatus CampaignStatus?
  /// CAS version — every authoritative mutation must supply expectedVersion = this value.
  version        Int             @default(1)

  icpDescription String
  targetIndustry String?
  targetRegion   String?
  enrichmentData Json?

  businessDescription String?
  valueProposition    String?
  provenStats         Json?

  dailySendLimit         Int   @default(25)
  qualificationThreshold Float @default(0.5)

  sendWindowStart Int?
  sendWindowEnd   Int?
  sendWindowDays  Int[]
  timezone        String?

  followUpDelayDays      Int     @default(3)
  followUpMaxSteps       Int     @default(2)
  regenAttempts          Int     @default(0)
  autoSendRepliesEnabled Boolean @default(false)
  inboundEnabled         Boolean @default(false)
  requireVerifiedEmailForGeneration Boolean @default(false)

  catchAllPolicy CatchAllPolicy @default(SKIP)
  templateStyle  TemplateStyle  @default(BRANDED)

  enrichmentBudgetCents Int?

  startedAt   DateTime?
  pausedAt    DateTime?
  completedAt DateTime?

  linkedInAccountId String?
  linkedInAccount   LinkedInAccount? @relation(fields: [linkedInAccountId], references: [accountId])

  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  senderDomainId String?
  senderDomain   SenderDomain? @relation(fields: [senderDomainId], references: [id])

  senderMailboxId String?
  senderMailbox   SenderMailbox? @relation("CampaignMailbox", fields: [senderMailboxId], references: [id])
  senderMailboxes SenderMailbox[] @relation("CampaignMailboxes")

  leads                Lead[]
  queueJobs            QueueJob[]
  deliverabilityEvents DeliverabilityEvent[]
  aiTraces             AITrace[]
  winRecords           WinRecord[]
  lossRecords          LossRecord[]
  sequenceSteps        SequenceStep[]
  stateStore           CampaignStateStore?
  discoveryRuns        DiscoveryRun[]
  qualityThreshold     CampaignQualityThreshold?
  scoringWeights       CampaignScoringWeights?
  agentColumns         LeadAgentColumn[]
  learningEvents       LearningEvent[]
  campaignRuns         CampaignRun[]
  enrichmentCosts      EnrichmentCostLedger[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([createdById])
  @@index([orgId])
  @@index([status])
  @@index([status, deletedAt])
  @@index([senderDomainId])
  @@index([senderMailboxId])
  @@index([linkedInAccountId])
}

model LinkedInAccount {
  id         String @id @default(cuid())
  accountId  String @unique
  name       String
  avatarUrl  String?
  profileUrl String?

  orgId       String?
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  campaigns Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([orgId])
}

model Lead {
  id String @id @default(cuid())

  leadState             LeadState            @default(DISCOVERED)
  leadStateVersion      Int                  @default(0)
  /// CAS version — every authoritative mutation must supply expectedVersion = this value.
  version               Int                  @default(1)
  emailValidationStatus EmailValidationStatus @default(UNKNOWN)

  companyName String
  website     String?
  domain      String?
  linkedinUrl String?
  breakdownScores   Json?
  recommendedAction String?

  firstName     String?
  lastName      String?
  email         String?
  emailStatus   EmailStatus @default(NOT_ATTEMPTED)
  emailSource   String?
  emailVerified Boolean     @default(false)
  emailCatchAll Boolean     @default(false)
  title         String?
  seniority     String?
  department    String?
  lastEnrichedAt      DateTime?
  qualificationScore  Float?
  qualificationReason String?
  sequenceInitError   String?
  decisionMakerScore  Float?

  competitorSignal Boolean  @default(false)
  competitorTech   String[] @default([])

  enrichmentData Json?
  embedding      Unsupported("vector(768)")?

  source     String?
  externalId String?

  lastContactedAt DateTime?

  pipelineStage          PipelineStage @default(PROSPECT)
  pipelineStageUpdatedAt DateTime?

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  signals            LeadSignal[]
  outreachMessages   OutreachMessage[]
  replies            Reply[]
  stepStatuses       LeadStepStatus[]
  linkedInActivities LinkedInActivity[]
  scoreSnapshots     LeadScoreSnapshot[]
  journeyEvents      LeadJourneyEvent[]
  winRecords         WinRecord[]
  lossRecords        LossRecord[]
  aiTraces           AITrace[]
  researchReports    LeadResearchReport[]
  agentRuns          LeadAgentRun[]
  emailRevealDecision EmailRevealDecision?
  enrichmentCosts     EnrichmentCostLedger[]

  researchCard             Json?
  researchCardGeneratedAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?


  @@index([campaignId])
  @@index([campaignId, deletedAt])
  @@index([campaignId, deletedAt, qualificationScore(sort: Desc)])
  @@unique([campaignId, externalId])
  @@index([companyId])
  @@index([pipelineStage])
  @@unique([campaignId, email])
  /// Multiple leads per domain per campaign are allowed (e.g. multi-stakeholder outreach)
  @@index([campaignId, domain])
  @@index([campaignId, pipelineStage])
  @@index([seniority])
  @@index([department])
  @@index([decisionMakerScore])
  @@index([emailStatus])
  @@index([emailValidationStatus])
  @@index([leadState])
  @@index([lastEnrichedAt])
  @@index([qualificationScore])
  @@index([lastContactedAt])
  @@index([campaignId, leadState, deletedAt])
}

model LeadSignal {
  id String @id @default(cuid())

  signalType      SignalType
  value           String
  confidence      Float
  source          String?
  sourceId        String?
  independenceKey String     @default("")
  explanation     String?

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime?
  isActive    Boolean   @default(true)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leadId, signalType, value])
  @@unique([leadId, independenceKey], map: "LeadSignal_leadId_independenceKey_key")
  @@index([leadId, isActive])
  @@index([signalType])
  @@index([expiresAt])
  @@index([independenceKey])
}

model OutreachMessage {
  id String @id @default(cuid())

  subject         String
  body            String
  originalSubject String?
  originalBody    String?
  diffVector      Json?
  subjectVariant  String?
  approvalStatus ApprovalStatus @default(PENDING)
  deliveryState  DeliveryState  @default(DRAFT)
  /// CAS version — every authoritative mutation must supply expectedVersion = this value.
  version        Int            @default(1)
  spamRiskScore        Float?
  personalizationScore Float?
  leadingSignal        String?
  claimToken           String?
  claimVersion         Int       @default(0)
  claimExpiresAt       DateTime?
  channel              Channel @default(EMAIL)

  externalMessageId String? @unique

  isFollowUp      Boolean @default(false)
  followUpStep    Int?

  parentMessageId String?
  parentMessage   OutreachMessage?  @relation("OutreachThread", fields: [parentMessageId], references: [id], onDelete: SetNull)
  childMessages   OutreachMessage[] @relation("OutreachThread")

  clicks Int @default(0)

  retryCount  Int       @default(0)
  lastError   String?
  nextRetryAt DateTime?

  payloadHash      String?
  complianceStatus String?

  approvedById String?
  approvedBy   User?  @relation(fields: [approvedById], references: [id])

  leadId String
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  senderMailboxId String?
  senderMailbox   SenderMailbox? @relation(fields: [senderMailboxId], references: [id])

  replies        Reply[]
  learningEvents LearningEvent[]
  winRecords     WinRecord[]
  lossRecords    LossRecord[]
  journeyEvents  LeadJourneyEvent[]

  sentAt               DateTime?
  deliveredAt          DateTime?
  openedAt             DateTime?
  repliedAt            DateTime?
  scheduledAt          DateTime?
  generationConfidence Float?
  enrichmentData       Json?
  regenerationNeeded   Boolean @default(false)
  regenerationReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([deliveryState])
  @@index([approvalStatus])
  @@index([externalMessageId])
  @@index([isFollowUp])
  @@index([leadId, isFollowUp])
  @@index([deliveryState, updatedAt])
  @@index([nextRetryAt])
  @@index([scheduledAt])
  @@index([sentAt])
  @@index([leadId, deliveryState, scheduledAt])
  @@unique([leadId, followUpStep], name: "outreach_message_lead_followup_step_unique", map: "outreach_message_lead_followup_step_unique")
  @@index([senderMailboxId])
  @@index([parentMessageId])
  @@index([claimExpiresAt])
  @@index([channel])
}

model Reply {
  id String @id @default(cuid())

  body              String
  providerMessageId String?     @unique
  intent            ReplyIntent @default(UNKNOWN)

  sentimentScore Float?
  confidence     Float?

  requiresHumanReview Boolean @default(false)
  normalizedBody      String?

  draftSubject        String?
  draftBody           String?
  objectionCategory   String?
  meetingLinkInjected Boolean @default(false)

  draftSentAt     DateTime?
  draftSentBy     String?
  draftSentByUser User?     @relation("ReplyDraftSentBy", fields: [draftSentBy], references: [id], onDelete: SetNull)
  draftExternalId String?

  buyingStage          String?
  painPoints           Json?
  competitorsMentioned Json?
  budgetSignal         String?
  timelineSignal       String?
  embedding            Unsupported("vector(768)")?
  oooReturnDate        DateTime? @db.Timestamptz

  outreachMessageId String
  outreachMessage   OutreachMessage @relation(fields: [outreachMessageId], references: [id])

  leadId String
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  winRecords    WinRecord[]
  lossRecords   LossRecord[]
  classifiedAt  DateTime?
  draftIntent   String?
  oooRequeuedAt DateTime?

  isRead        Boolean   @default(false)
  snoozedUntil  DateTime?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([leadId])
  @@index([outreachMessageId])
  @@index([intent])
  @@index([normalizedBody])
  @@index([draftSentAt])
  @@index([draftSentBy])
  @@index([requiresHumanReview])
  @@index([createdAt])
  @@index([oooRequeuedAt])
  @@index([isRead])
  @@index([snoozedUntil])
  @@index([intent, createdAt])
}

model WinRecord {
  id                 String    @id @default(cuid())
  icpVertical        String?
  targetIndustry     String?
  targetRegion       String?
  signalType         SignalType
  signalValue        String
  subjectPattern     String
  bodyOpeningPattern String
  tone               String?
  replyIntent        String
  sentimentScore     Float?
  embedding          Unsupported("vector(768)")?

  qualificationScoreAtCapture Float?
  pipelineStageAtCapture      PipelineStage?

  outreachMessageId String
  outreachMessage   OutreachMessage @relation(fields: [outreachMessageId], references: [id], onDelete: Restrict)

  replyId String
  reply   Reply  @relation(fields: [replyId], references: [id], onDelete: Restrict)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([icpVertical])
  @@index([signalType])
  @@index([campaignId])
  @@index([outreachMessageId])
  @@index([replyId])
  @@index([leadId])
}

model LossRecord {
  id                String  @id @default(cuid())
  icpVertical       String?
  targetIndustry    String?
  targetRegion      String?
  signalUsed        String?
  inferredObjection String
  bodyPattern       String?
  tone              String?
  replyIntent       String
  sentimentScore    Float?
  embedding         Unsupported("vector(768)")?

  qualificationScoreAtCapture Float?
  pipelineStageAtCapture      PipelineStage?

  outreachMessageId String
  outreachMessage   OutreachMessage @relation(fields: [outreachMessageId], references: [id], onDelete: Restrict)

  replyId String
  reply   Reply  @relation(fields: [replyId], references: [id], onDelete: Restrict)

  campaignId String
