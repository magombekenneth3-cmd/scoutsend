  metadata            Json?

  @@index([organizationId, createdAt])
  @@index([outboxEventId])
}

model ProviderDeliveryAttempt {
  id                String    @id @default(cuid())
  organizationId    String
  outboxEventId     String
  attemptNumber     Int
  leaseToken        String?
  workerId          String?
  provider          String
  providerMessageId String?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  latencyMs         Int?
  outcome           String    @default("PROCESSING")
  statusCode        Int?
  errorCode         String?
  createdAt         DateTime  @default(now())

  @@unique([outboxEventId, attemptNumber])
  @@index([organizationId, createdAt])
  @@index([organizationId, outcome, createdAt])
}

model OutboxFencingIncident {
  id                String    @id @default(cuid())
  organizationId    String
  outboxEventId     String
  staleLeaseToken   String
  currentLeaseToken String?
  leaseExpiresAt    DateTime?
  workerId          String?
  occurredAt        DateTime  @default(now())

  @@index([organizationId, occurredAt])
  @@index([outboxEventId])
}

model EmailRevealDecision {
  id           String   @id @default(cuid())
  leadId       String   @unique
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  score        Float
  threshold    Float
  decision     String
  scoringRunId String
  decidedAt    DateTime @default(now())

  @@index([leadId])
  @@index([decision])
}

enum SendIntentStatus {
  PENDING
  DISPATCHING
  ACCEPTED
  SENT
  FAILED
  UNKNOWN
  RECONCILING
  UNRESOLVED
  HUMAN_REVIEW
}

model SendIntent {
  id                String           @id @default(cuid())
  operationId       String           @unique
  leadId            String
  campaignId        String?
  mailboxId         String?
  outreachMessageId String           @unique
  sequenceStep      Int
  idempotencyKey    String           @unique
  traceId           String?
  status            SendIntentStatus @default(PENDING)
  providerMessageId String?
  provider          String?
  payloadHash       String?
  attemptCount      Int              @default(0)
  lastAttemptAt     DateTime?
  errorMessage      String?

  /// Worker lease & fencing authority
  claimedBy      String?
  fencingEpoch   Int       @default(1)
  leaseVersion   Int       @default(1)
  leaseExpiresAt DateTime?

  /// Reconciliation sweeper — how many times UNKNOWN state has been polled
  reconciliationAttempts Int @default(0)

  /// CAS version — every authoritative mutation must supply expectedVersion = this value.
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([campaignId])
  @@index([mailboxId])
  @@index([status])
  @@index([status, updatedAt])
  @@index([idempotencyKey])
  @@index([claimedBy, leaseExpiresAt])
  /// Stale-lease sweeper: DISPATCHING + expired lease
  @@index([status, leaseExpiresAt])
  /// UNKNOWN reconciliation sweeper: ordered by oldest first
  @@index([status, reconciliationAttempts, updatedAt])
  /// Authoritative SendIntent resolution: fast index-only scan by campaignId + createdAt desc + id desc
  @@index([campaignId, createdAt(sort: Desc), id(sort: Desc)])
}

enum QuotaScope {
  MAILBOX
  DOMAIN
  CAMPAIGN
  SMTP_HOST
}

enum QuotaReservationStatus {
  RESERVED
  CONSUMED
  RELEASED
  HELD
}

model QuotaReservation {
  id            String                 @id @default(cuid())
  operationId   String
  scope         QuotaScope
  scopeId       String
  amount        Int                    @default(1)
  status        QuotaReservationStatus @default(RESERVED)
  windowStart   DateTime
  /// CAS version — every authoritative mutation must supply expectedVersion = this value.
  version       Int                    @default(1)
  createdAt     DateTime               @default(now())
  expiresAt     DateTime

  @@unique([operationId, scope, scopeId])
  @@index([scope, scopeId, status])
  @@index([status, expiresAt])
  @@index([operationId])
}

enum CampaignRunStatus {
  CREATED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  RECOVERING
}

model CampaignRun {
  id           String            @id @default(cuid())
  campaignId   String
  campaign     Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// Monotonically increasing. Incremented on every lease takeover so stale workers are permanently invalid.
  fencingEpoch Int               @default(1)
  status       CampaignRunStatus @default(CREATED)
  /// CAS version — every authoritative mutation must supply expectedVersion = this value.
  version      Int      @default(1)
  /// For event ordering / outbox sequencing only. Not used for CAS.
  logicalVersion Int    @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leases       CampaignRunLease[]

  @@index([campaignId, status])
}

model CampaignRunLease {
  id             String      @id @default(cuid())
  campaignRunId  String
  campaignRun    CampaignRun @relation(fields: [campaignRunId], references: [id], onDelete: Cascade)
  workerId       String
  /// Must equal CampaignRun.fencingEpoch at time of claim. Permanently invalid when CampaignRun.fencingEpoch increments.
  fencingEpoch   Int
  /// CAS-protected renewal counter within this epoch.
  leaseVersion   Int         @default(1)
  leaseExpiresAt DateTime
  createdAt      DateTime    @default(now())

  @@unique([campaignRunId, fencingEpoch])
  @@index([workerId, leaseExpiresAt])
  @@index([leaseExpiresAt])
}

model EnrichmentCostLedger {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  provider   String   /// e.g. APOLLO_REVEAL, HUNTER, ZEROBOUNCE, PDL, PROXYCURL, APIFY_LINKEDIN
  operation  String   /// e.g. email_reveal, email_verify, company_enrich, person_enrich
  costCents  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([campaignId])
  @@index([leadId])
  @@index([createdAt])
}